# Librerias descargadas con pip --target
.libs/
# Cache de descargas (el Excel de Damodaran)
.cache/
# Borradores y entregas: se regeneran
borradores/
hoy/
final/
entrega/
# Los .docx que genera el motor se regeneran y no van al repo.
*.docx
# EXCEPCION: los originales que escribe la redaccion. El de Oscar sobre el
# acuerdo petrolero vivia solo en Descargas, que es donde se pierden las cosas.
# Es la base de cuatro articulos y una editorial: si desaparece, se rehace a
# mano lo que ya estaba hecho.
!documentos/*.docx
~$*
__pycache__/
*.pyc

# Producto de cada corrida: se regenera y no es codigo. Mismo criterio que
# borradores/ y hoy/, que ya estaban fuera.
carga-*.json
corrida-*/
28-noticias/
*-noticias/
ilustracion.png
prueba_ilustracion.png
28-articulo/
*.b64

# Respaldo de imagenes antes de migrar a Cloudflare R2: 340 MB de originales.
# Los INVENTARIOS si van al repo (las excepciones de abajo): sin ellos los
# archivos son bytes sueltos y nadie sabe que imagen era de que pieza.
respaldo-imagenes/*
!respaldo-imagenes/registro.json
!respaldo-imagenes/mapa-portadas.json
!respaldo-imagenes/sin-asset/
respaldo-imagenes/sin-asset/*
!respaldo-imagenes/sin-asset/registro.json
